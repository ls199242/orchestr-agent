            "code": "query_weather_tool",
            "title": "到达地实时天气时段查询工具",
            "description": "根据机场三字码和到达城市，查询当前落地时刻的实时天气状况（晴、雨、雪等）、温度以及当前是否属于夜间时段",
            "endpoint": "http://127.0.0.1:8000/mock/tools/weather",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "city": {"type": "string", "description": "落地城市，例如：上海"},
                        "airportCode": {"type": "string", "description": "落地机场代码，例如：SHA"},
                    },
                    "required": ["city", "airportCode"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "weather": {"type": "string", "enum": ["RAINY", "SUNNY", "CLOUDY", "SNOW"]},
                        "temperature": {"type": "number", "description": "摄氏度"},
                        "isNight": {"type": "boolean", "description": "是否夜间时段（20:00-06:00）"},
                        "description": {"type": "string", "description": "天气概述说明"},
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
        {
            "name": "query_user_profile_tool",
            "code": "query_user_profile_tool",
            "title": "旅客消费偏好画像查询工具",
            "description": "根据用户 ID 查询旅客的历史消费能力、价格敏感度以及客群偏好标签（价格优先型 PRICE_FIRST 或 体验优先型 EXPERIENCE_FIRST）",
            "endpoint": "http://127.0.0.1:8000/mock/tools/user-profile",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "userId": {"type": "string", "description": "旅客会员ID"},
                    },
                    "required": ["userId"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "preferenceType": {"type": "string", "enum": ["PRICE_FIRST", "EXPERIENCE_FIRST"], "description": "价格优先型或体验优先型"},
                        "historicalSpendingLevel": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                        "frequentHotelStar": {"type": "integer", "description": "常住酒店星级"},
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
        {
            "name": "query_arrival_services_tool",
            "code": "query_arrival_services_tool",
            "title": "落地目的地周边供给服务检索工具",
            "description": "查询落地机场附近的现货服务，包括接送机接机专车、周边高评分酒店、热门景点门票信息",
            "endpoint": "http://127.0.0.1:8000/mock/tools/arrival-services",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "airportCode": {"type": "string", "description": "落地机场三字码"},
                    },
                    "required": ["airportCode"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "pickupServices": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "serviceId": {"type": "string"},
                                    "carType": {"type": "string"},
                                    "title": {"type": "string"},
                                    "price": {"type": "number"},
                                    "features": {"type": "string"},
                                },
                            },
                        },
                        "hotels": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "hotelId": {"type": "string"},
                                    "name": {"type": "string"},
                                    "star": {"type": "integer"},
                                    "distanceKm": {"type": "number"},
                                    "price": {"type": "number"},
                                },
                            },
                        },
                        "attractions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "ticketId": {"type": "string"},
                                    "name": {"type": "string"},
                                    "price": {"type": "number"},
                                    "tag": {"type": "string"},
                                },
                            },
                        },
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
        {
            "name": "query_user_info_tool",
            "code": "query_user_info_tool",
            "title": "旅客基础信息与会员画像查询工具",
            "description": "根据旅客会员 ID 查询旅客姓名、会员等级（普通/银卡/金卡/白金卡）、常驻城市、主选航司、价格敏感度画像",
            "endpoint": "http://127.0.0.1:8000/mock/tools/user-info",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "userId": {"type": "string", "description": "旅客会员唯一ID，如 U1001"},
                    },
                    "required": ["userId"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "userId": {"type": "string"},
                        "userName": {"type": "string"},
                        "memberTier": {"type": "string", "enum": ["REGULAR", "SILVER", "GOLD", "PLATINUM"]},
                        "homeCity": {"type": "string"},
                        "preferredAirlines": {"type": "array", "items": {"type": "string"}},
                        "preferredCabin": {"type": "string", "enum": ["ECONOMY", "PREMIUM_ECONOMY", "BUSINESS", "FIRST"]},
                        "priceSensitivity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
                        "tags": {"type": "array", "items": {"type": "string"}},
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
        {
            "name": "query_user_orders_tool",
            "code": "query_user_orders_tool",
            "title": "旅客历史机票订单与出行习惯查询工具",
            "description": "查询旅客近半年内的机票历史行程、实际起降时段、机型喜好、购票均价与退改签频次",
            "endpoint": "http://127.0.0.1:8000/mock/tools/user-orders",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "userId": {"type": "string", "description": "旅客会员ID"},
                        "limit": {"type": "integer", "description": "返回历史订单最大条数"},
                    },
                    "required": ["userId"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "userId": {"type": "string"},
                        "totalOrders": {"type": "integer"},
                        "orders": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "orderId": {"type": "string"},
                                    "flightNo": {"type": "string"},
                                    "airline": {"type": "string"},
                                    "depAirport": {"type": "string"},
                                    "arrAirport": {"type": "string"},
                                    "depDate": {"type": "string"},
                                    "depTime": {"type": "string"},
                                    "cabinClass": {"type": "string"},
                                    "ticketPrice": {"type": "number"},
                                },
                            },
                        },
                        "frequentDepTimeSlot": {"type": "string"},
                        "frequentAirlines": {"type": "array", "items": {"type": "string"}},
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
        {
            "name": "query_flight_schedule_tool",
            "code": "query_flight_schedule_tool",
            "title": "实时航班时刻与周边机场航班检索工具",
            "description": "查询指定出发地与目的地航线的航班，支持入参扩展临近日期（±1~2天）与同城临近机场（如 SHA/PVG, PEK/PKX）",
            "endpoint": "http://127.0.0.1:8000/mock/tools/flights",
            "requestJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "departureCity": {"type": "string", "description": "出发城市或机场代码，如 北京/PEK"},
                        "arrivalCity": {"type": "string", "description": "到达城市或机场代码，如 上海/SHA"},
                        "departureDate": {"type": "string", "description": "期望起飞日期，YYYY-MM-DD"},
                        "returnDate": {"type": "string", "description": "返程/抵达日期（可选）"},
                        "includeNearbyDays": {"type": "integer", "description": "前后临近浮动天数，如 1"},
                        "includeNearbyAirports": {"type": "boolean", "description": "是否自动扩展同城及临近机场"},
                    },
                    "required": ["departureCity", "arrivalCity", "departureDate"],
                },
                ensure_ascii=False,
            ),
            "responseJsonSchema": json.dumps(
                {
                    "type": "object",
                    "properties": {
                        "flights": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "flightNo": {"type": "string"},
                                    "airline": {"type": "string"},
                                    "depAirport": {"type": "string"},
                                    "arrAirport": {"type": "string"},
                                    "depDate": {"type": "string"},
                                    "depTime": {"type": "string"},
                                    "arrTime": {"type": "string"},
                                    "price": {"type": "number"},
                                    "seatClass": {"type": "string"},
                                    "punctualityRate": {"type": "string"},
                                    "isNearbyDate": {"type": "boolean"},
                                    "isNearbyAirport": {"type": "boolean"},
                                    "aircraftType": {"type": "string"},
                                },
                            },
                        },
                    },
                },
                ensure_ascii=False,
            ),
            "parameters": {},
        },
    ],

    # 2.4 大模型接入配置 (ModelConfigDO)
    "models": [
        {
            "code": "Deepseek",
            "name": "Deepseek",
            "modelName": "deepseek-flash",
            "contextMaxTokens": 64000,
            "endpoint": "http://127.0.0.1:8000/mock/llm/v1",
            "apiKey": "mock-api-key",  # 可替换为真实 API Key (如需直连线上 DeepSeek) 或保留本地 Mock 端点
            "temperature": 0.7,
            "supportImage": False,
            "tags": ["chat", "reasoning"],
        },
    ],

    # 2.5 全局运行字典 (DictDO)
    "dict": [
        {
            "key": "flow_max_step",
            "value": "20",
            "description": "流程最大执行步长限制",
        },
        {
            "key": "llm_max_wait_time",
            "value": "30000",
            "description": "大模型调用最大等待毫秒数",
        },
        {
            "key": "flow_result_cache_save_time",
            "value": "3600",
            "description": "流程执行结果缓存有效时间（秒）",
        },
        {
            "key": "flow_chat_history_save_time",
            "value": "86400",
            "description": "聊天多轮记忆临时缓存保存时间（秒）",
        },
        {
            "key": "flow_chat_history_summary_token_size",
            "value": "20000",
            "description": "触发多轮会话摘要压缩的 Token 门槛阈值",
        },
        {
            "key": "log_flag",
            "value": "true",
            "description": "全局日志详细跟踪输出开关",
        },
        {
            "key": "flow_eval_max_retry",
            "value": "2",
            "description": "Evaluator 验收失败时的自愈重试最大次数",
        },
        {
            "key": "flow_instance_expire_minutes",
            "value": "30",
            "description": "流程实例与上下文在内存缓存中的驻留淘汰时间（分钟）",
        },
        {
            "key": "flow_instance_max_capacity",
            "value": "10000",
            "description": "流程实例本地缓存最大并发容量限制",
        },
        {
            "key": "log_stream_max_lines",
            "value": "1000",
            "description": "实时日志流初次建立连接时回溯读取的最大行数",
        },
        {
            "key": "log_stream_poll_interval_ms",
            "value": "200",
            "description": "日志流增量读取文件更新的轮询时间间隔（毫秒）",
        },
        {
            "key": "default_llm_model",
            "value": "Deepseek",
            "description": "系统各智能体未指定模型时的全局默认大模型名称",
        },
        {
            "key": "default_system_agent_temp",
            "value": "0.7",
            "description": "系统智能体默认采样温度（未在 AgentConfig 配置时的保底值）",
        },
        {
            "key": "default_expert_agent_temp",
            "value": "0.3",
            "description": "业务 Expert 智能体默认采样温度（未在策略或配置中指定时的保底值）",
        },
    ],
}
